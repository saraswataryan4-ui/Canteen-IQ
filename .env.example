# Server configuration
PORT=3000

# Google Gemini API key for Gemma dining assistant (server-side only)
# - In AI Studio: Attach/Select an API key or set GEMINI_API_KEY in Settings > Secrets
# - In Vercel / Render / Cloud Run / GitHub Actions: Add GEMINI_API_KEY in Environment Variables / Secrets
# - In Local Development: Copy this file to .env or .env.local and populate GEMINI_API_KEY
GEMINI_API_KEY=

# Vite development flag (managed by environment)
DISABLE_HMR=false
